{
  "manifest_version": 3,
  "name": "Maths n Me – Wayground Reports",
  "version": "0.1.0",
  "description": "Saves completed Wayground quiz results to the signed-in student's Maths n Me reports.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*.wayground.com/*", "https://*.quizizz.com/*", "https://*.joinmyquiz.com/*", "http://localhost:3000/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://*.wayground.com/*", "https://*.quizizz.com/*", "https://*.joinmyquiz.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Maths n Me Reports",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
